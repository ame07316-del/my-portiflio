# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty in local development: an embedded Postgres (PGlite)
# is created automatically in .data/pgdata.
# In production point it at Supabase / Neon / Vercel Postgres, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
# ---------------------------------------------------------------------------
DATABASE_URL=

# Secret used to sign the admin session cookie (min 32 chars).
AUTH_SECRET="change-me-to-a-long-random-string-please"

# Seeded on first run only.
ADMIN_EMAIL="admin@portfolio.dev"
ADMIN_PASSWORD="admin1234"
