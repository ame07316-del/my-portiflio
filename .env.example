# ---------------------------------------------------------------------------
# PostgreSQL database
#
# Local development: leave DATABASE_URL empty to use embedded PGlite in .data/pgdata.
# If you intentionally use a local PostgreSQL server without TLS, set
# DATABASE_URL to its local postgres:// URI and add ?sslmode=disable explicitly.
# Remote plaintext / sslmode=no-verify is rejected. Do not set NODE_TLS_REJECT_UNAUTHORIZED=0.
#
# Supabase (the provider documented by this repository): Dashboard → project →
# Connect → Connection string → URI. For Vercel, choose Transaction Pooler
# (normally port 6543). Copy a PostgreSQL URI, not the HTTPS REST/API URL.
# If the provider's copied URI uses sslmode=require, the shared config still
# enforces rejectUnauthorized=true and hostname verification. Prefer the
# provider's documented sslmode=verify-full when it is offered.
#
# Example only (fake credentials and host; never paste a real value into chat):
# DATABASE_URL="postgresql://postgres.fakeproject:FAKE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=verify-full"
DATABASE_URL=

# Optional trusted CA bundle for providers that require a private/non-system CA.
# Paste the PEM CA certificate(s) from the provider's official dashboard/docs.
# DATABASE_SSL_CA accepts real multiline PEM or a single-line value with literal
# \n sequences. Do NOT use a server/leaf certificate copied from a failed
# connection, a file path, or a private key. It applies only to this DB socket.
# A configured CA is validated and keeps rejectUnauthorized=true; it does not
# disable hostname checks. Empty means use Node's normal trusted root store.
DATABASE_SSL_CA=

# Max connections in the pool (keep it small on serverless).
DATABASE_POOL_MAX=3

# Secret used to sign the admin session cookie (min 32 chars).
# Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-please"

# The single key that opens /admin (sign-in is token-only).
# Leave empty to fall back to the token stored in the database
# (default: amr-portfolio-2025) — set your own before deploying.
ADMIN_TOKEN=""

# Seeded on the first run only — the `users` row behind Admin → Account.
# These are NOT used to sign in (sign-in is token-only).
ADMIN_EMAIL="ame07316@gmail.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Used for absolute URLs in metadata / social cards.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
