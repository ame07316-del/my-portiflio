# ---------------------------------------------------------------------------
# Database
#
# Local development: leave DATABASE_URL empty — an embedded PostgreSQL (PGlite)
# is created automatically in .data/pgdata.
#
# Production (Supabase): Project → Connect → "Connection string" → URI.
#   Serverless (Vercel):  use the Transaction pooler, port 6543
#   Long-lived server:    use the Session pooler / direct connection, port 5432
#   Remember to append ?sslmode=require and replace [YOUR-PASSWORD].
#
# DATABASE_URL="postgresql://postgres.abcdefghijkl:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"
# ---------------------------------------------------------------------------
DATABASE_URL=

# Max connections in the pool (keep it small on serverless).
DATABASE_POOL_MAX=3

# Secret used to sign the admin session cookie (min 32 chars).
# Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-please"

# The single key that opens /admin (sign-in is token-only).
# Leave empty to fall back to the token stored in the database
# (default: amr-portfolio-2025) — set your own before deploying.
ADMIN_TOKEN=""

# Seeded on the first run only — the `users` row behind Admin → Account.
# These are NOT used to sign in.
ADMIN_EMAIL="ame07316@gmail.com"
ADMIN_PASSWORD="admin1234"

# Used for absolute URLs in metadata / social cards.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
